# Ambiente: development (default) ou production. Em production, ADMIN_TOKEN ausente derruba o boot.
APP_ENV=development
PORT=3000
# Banco SQLite; ':memory:' recria o seed a cada boot.
DATABASE_FILE=:memory:

# Guards de acesso (T08). Desligadas por default: as rotas respondem 403.
# Ligadas: exigem o header X-Admin-Token igual a ADMIN_TOKEN (401 sem ele).
ENABLE_ADMIN_ROUTES=false
ENABLE_SENSITIVE_READS=false
ENABLE_WRITE_ROUTES=false
ADMIN_TOKEN=
