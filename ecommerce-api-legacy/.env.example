# development | production (em production, segredos ausentes derrubam o boot)
APP_ENV=development
PORT=3000

# Chave do gateway de pagamento (simulado; vazio é aceito)
PAYMENT_GATEWAY_KEY=

# Rotas administrativas (relatório financeiro e exclusão de usuário).
# Desligadas por padrão: respondem 403. Ligadas, exigem o header X-Admin-Token.
ENABLE_ADMIN_ROUTES=false
ADMIN_TOKEN=
