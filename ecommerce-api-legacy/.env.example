APP_ENV=development
PORT=3000
DATABASE_FILE=:memory:
# Chave do gateway de pagamento (a antiga pk_live_ estava no repositório e precisa ser rotacionada)
PAYMENT_GATEWAY_KEY=
# Guards T08 (default false: rotas respondem 403)
ENABLE_ADMIN_ROUTES=false
ENABLE_SENSITIVE_READS=false
ENABLE_WRITE_ROUTES=false
# Obrigatório quando alguma flag estiver ligada; enviado no header X-Admin-Token
ADMIN_TOKEN=
