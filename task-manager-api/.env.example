# Ambiente: development (default) ou production (segredos ausentes derrubam o boot)
APP_ENV=development
SECRET_KEY=
DATABASE_URL=sqlite:///tasks.db
HOST=0.0.0.0
PORT=5000
DEBUG=false
# Origens permitidas no CORS, separadas por vírgula. Vazio = CORS desligado.
CORS_ORIGINS=

# Guards de acesso (desligados = 403; ligados exigem o header X-Admin-Token)
ENABLE_ADMIN_ROUTES=false
ENABLE_SENSITIVE_READS=false
ENABLE_WRITE_ROUTES=false
ADMIN_TOKEN=
