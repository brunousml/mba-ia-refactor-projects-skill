# Copie para .env e preencha. Nenhum valor real deve ir para o repositório.
APP_ENV=development
# Obrigatória em produção; em desenvolvimento, ausente = valor aleatório a cada boot
SECRET_KEY=
DATABASE_URI=sqlite:///tasks.db
HOST=0.0.0.0
PORT=5000
DEBUG=false
LOG_LEVEL=INFO
# Lista separada por vírgula. Ausente: "*" em desenvolvimento, nenhuma origem em produção
CORS_ORIGINS=
# Rotas de exclusão e de relatório (403 enquanto false)
ENABLE_ADMIN_ROUTES=false
ADMIN_TOKEN=
