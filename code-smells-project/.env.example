# development | production (em production, SECRET_KEY é obrigatória e ADMIN_TOKEN também se alguma flag estiver ligada)
APP_ENV=development
SECRET_KEY=
HOST=0.0.0.0
PORT=5000
DEBUG=false
DB_PATH=loja.db
# Origens liberadas para CORS, separadas por vírgula (vazio = sem CORS)
CORS_ORIGINS=

# T08: rotas protegidas ficam desligadas (403) por padrão.
# Ligadas, exigem o header X-Admin-Token igual a ADMIN_TOKEN (senão 401).
ENABLE_ADMIN_ROUTES=false
ENABLE_SENSITIVE_READS=false
ENABLE_WRITE_ROUTES=false
ADMIN_TOKEN=
