# development (padrão) gera SECRET_KEY aleatória com warning; production exige SECRET_KEY definida
APP_ENV=development
SECRET_KEY=
HOST=0.0.0.0
PORT=5000
DEBUG=false
DB_PATH=loja.db
# Origens liberadas no CORS, separadas por vírgula ("*" libera todas)
CORS_ORIGINS=*
# Rotas /admin/* respondem 403 enquanto false; com true exigem o header X-Admin-Token
ENABLE_ADMIN_ROUTES=false
ADMIN_TOKEN=
