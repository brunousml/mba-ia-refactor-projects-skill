# Copie para .env e preencha. Nenhum valor real deve ir para o repositório.
APP_ENV=development
SECRET_KEY=troque-por-um-valor-longo-e-aleatorio
DEBUG=false
HOST=0.0.0.0
PORT=5000
DB_PATH=loja.db
# Origens liberadas para CORS, separadas por vírgula. Vazio = nenhuma.
CORS_ORIGINS=
# Rotas protegidas (default desligado). Ligadas exigem X-Admin-Token == ADMIN_TOKEN.
ENABLE_ADMIN_ROUTES=false
ENABLE_SENSITIVE_READS=false
ENABLE_WRITE_ROUTES=false
ADMIN_TOKEN=
